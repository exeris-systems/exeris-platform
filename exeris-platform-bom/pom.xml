<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.platform</groupId>
        <artifactId>exeris-platform-root</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>exeris-platform-bom</artifactId>
    <packaging>pom</packaging>

    <name>Exeris Platform :: BOM</name>
    <description>Bill of materials for platform modules and third-party deps.</description>

    <properties>
        <!-- Keep in sync with the sibling checkout refs in .github/workflows/build.yml.
             A bump here that forgets the workflow ref silently builds the wrong version.

             The SDK is now pinned to a RELEASE (0.10.0) and the workflow checks out the
             immutable v0.10.0 tag rather than the moving main ref — the same correction
             exeris-tooling made in its U0. `-io` ships as a release now, so the old
             "SNAPSHOT-only, so track main" rationale has lapsed. A moving ref lets an
             unrelated upstream commit turn this build red.

             exeris-tooling has no release carrying what this repo references, so it stays
             a SNAPSHOT built from main. Note it is currently referenced by
             dependencyManagement only — no module declares a dependency on
             exeris-codegen-core and no Java source imports eu.exeris.tooling. -->
        <exeris.sdk.version>0.10.0</exeris.sdk.version>
        <exeris.tooling.version>0.7.0</exeris.tooling.version>

        <lsp4j.version>0.23.1</lsp4j.version>

        <!-- exeris/applyMutation transports the SDK-owned MutationOp / MutationResult shapes,
             which are Jackson-polymorphic (op/outcome discriminators). LSP4J serializes with
             Gson (which ignores @JsonTypeInfo), so the server (de)serializes those payloads with
             the SDK's Jackson 3 contract instead.
             Pinned to 3.2.0 (NOT the SDK BOM's 3.1.2). The CVE history forced two bumps:
               - 3.1.2 → 3.1.4 cleared CVE-2026-54512/54513/54514/54517/54518 (two critical);
               - 3.1.4 → 3.2.0 clears CVE-2026-54515 (CWE-915); there is no 3.1.5, so 3.2.0 is the fix.
             We deliberately run AHEAD of the SDK. Our usage is minimal and version-robust
             (JsonMapper.builder + readValue/writeValueAsString/valueToTree), and the mutation
             polymorphism is the SAFE form — @JsonTypeInfo(use=Id.NAME) over a closed @JsonSubTypes
             allowlist (9 ops), never default typing — so these deserialization CVEs are not
             reachable in our path; we bump anyway to keep the Snyk gate clean. Importing the SDK
             BOM is NOT an option until it bumps (it would pull a vulnerable version back in); drop
             this explicit pin once the SDK BOM is >= 3.2.0.
             gson is LSP4J's own JSON layer; pinned so the JsonElement wire boundary is explicit. -->
        <jackson.version>3.2.0</jackson.version>
        <gson.version>2.11.0</gson.version>

        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Exeris SDK -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-annotations</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-source-model</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <!-- Parser/writer/conflict-detector over @ExerisDomain sources; consumed by the LSP server. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-source-model-io</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>

            <!-- LSP framework (JSON-RPC, base protocol, stdio launcher) -->
            <dependency>
                <groupId>org.eclipse.lsp4j</groupId>
                <artifactId>org.eclipse.lsp4j</artifactId>
                <version>${lsp4j.version}</version>
            </dependency>

            <!-- JSON: gson is LSP4J's wire layer (JsonElement boundary for exeris/applyMutation);
                 jackson-databind 3 (de)serializes the SDK's polymorphic mutation shapes per the
                 SDK consumer contract (FAIL_ON_NULL_FOR_PRIMITIVES=false). -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Exeris Tooling (build-time, available for Studio integration) -->
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-codegen-core</artifactId>
                <version>${exeris.tooling.version}</version>
            </dependency>

            <!-- Internal platform modules -->
            <dependency>
                <groupId>eu.exeris.platform</groupId>
                <artifactId>exeris-studio-backend</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.platform</groupId>
                <artifactId>exeris-platform-lsp</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Test deps -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
