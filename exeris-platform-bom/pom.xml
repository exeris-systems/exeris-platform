<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.platform</groupId>
        <artifactId>exeris-platform-root</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>exeris-platform-bom</artifactId>
    <packaging>pom</packaging>

    <name>Exeris Platform :: BOM</name>
    <description>Bill of materials for platform modules and third-party deps.</description>

    <properties>
        <!-- The Exeris stack resolves from Maven Central like any other dependency: kernel, sdk and
             tooling are all published there, so the build holds no sibling checkout and these three
             properties are the only place the Maven side names the stack versions.

             exeris-sdk-bom is IMPORTED below rather than restated, so the SDK modules and the
             third-party versions the SDK is built and tested against (Jackson among them) have one
             source of truth: bumping exeris.sdk.version moves them together.

             From exeris-tooling, exeris-processor is the one artifact a module consumes — the
             annotation processor exeris-studio-backend runs to emit its exeris-metadata/*.json
             corpus; exeris-codegen-core is managed but not consumed. The same corpus feeds
             `@exeris/codegen-ts`, the npm half of the tooling release (outside the tooling Maven
             reactor), which generates the Studio's own Angular 22 screens under
             exeris-studio-frontend/src/app/generated. The devDependency in
             exeris-studio-frontend/package.json names the same tooling version as this property;
             move both together. -->
        <exeris.sdk.version>0.12.0</exeris.sdk.version>
        <exeris.tooling.version>0.9.0</exeris.tooling.version>
        <exeris.kernel.version>0.12.0</exeris.kernel.version>

        <lsp4j.version>0.23.1</lsp4j.version>

        <!-- Jackson is deliberately NOT pinned here. exeris/applyMutation transports the SDK-owned
             MutationOp / MutationResult shapes, which are Jackson-polymorphic (op/outcome
             discriminators); LSP4J serializes with Gson, which ignores @JsonTypeInfo, so the server
             (de)serializes those payloads with the SDK's own Jackson 3 contract. Running the version
             the SDK was built and tested with is therefore the correctness requirement, and the
             imported exeris-sdk-bom is what supplies it — jackson-databind on the 3.x line paired
             with jackson-annotations on the 2.x line, as jackson-bom dictates. A local pin could
             only drift from that pairing. A security fix that cannot wait for an SDK release is
             taken as a jackson-bom PATCH release on the SDK's minor line, imported ahead of
             exeris-sdk-bom (the first import that manages a coordinate wins), so jackson-core and
             jackson-databind move together and the annotations pairing stays jackson-bom's own.
             jackson.version below is that override: it is dropped by the SDK bump whose BOM
             manages the same version or later.

             gson is LSP4J's own JSON layer; pinned so the JsonElement wire boundary is explicit. -->
        <jackson.version>3.2.3</jackson.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Exeris SDK: its modules (annotations, source-model, source-model-io — the
                 parser/writer/conflict-detector the LSP server consumes) and the third-party
                 versions it is tested against (Jackson, JavaParser, JUnit, AssertJ). Explicit
                 entries in this BOM win over the import, so the import is the default and never
                 overrides a deliberate choice made here. -->
            <!-- Ahead of exeris-sdk-bom on purpose: see jackson.version. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-bom</artifactId>
                <version>${exeris.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Exeris Kernel SPI & Community (WebSocket transport ADR-084) -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-spi</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-community</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>

            <!-- LSP framework (JSON-RPC, base protocol, stdio launcher) -->
            <dependency>
                <groupId>org.eclipse.lsp4j</groupId>
                <artifactId>org.eclipse.lsp4j</artifactId>
                <version>${lsp4j.version}</version>
            </dependency>

            <!-- gson is LSP4J's wire layer (JsonElement boundary for exeris/applyMutation).
                 jackson-databind, which (de)serializes the SDK's polymorphic mutation shapes, is
                 managed by the exeris-sdk-bom import above. -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>

            <!-- Exeris Tooling (build-time). exeris-processor is the annotation processor that
                 turns @ExerisDomain sources into the exeris-metadata/*.json corpus; codegen-core
                 is the emitter side, not yet consumed here. -->
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-processor</artifactId>
                <version>${exeris.tooling.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-codegen-core</artifactId>
                <version>${exeris.tooling.version}</version>
            </dependency>

            <!-- Internal platform modules -->
            <dependency>
                <groupId>eu.exeris.platform</groupId>
                <artifactId>exeris-studio-backend</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.platform</groupId>
                <artifactId>exeris-platform-lsp</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Test deps (junit-jupiter, assertj-core) are managed by the exeris-sdk-bom import. -->
        </dependencies>
    </dependencyManagement>
</project>
