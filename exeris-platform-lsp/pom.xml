<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.platform</groupId>
        <artifactId>exeris-platform-parent</artifactId>
        <version>0.5.0-SNAPSHOT</version>
        <relativePath>../exeris-platform-parent</relativePath>
    </parent>

    <artifactId>exeris-platform-lsp</artifactId>
    <packaging>jar</packaging>

    <name>Exeris Platform :: LSP Server</name>
    <description>
        Language Server Protocol implementation hosting the canonical
        DomainMetadata model. Single LSP server consumed by Studio (web/desktop),
        IntelliJ plugin, and VS Code extension — guaranteeing one model, one
        edit pipeline, idempotent .java write-back, and bidirectional sync
        between Studio edits and IDE edits.
    </description>

    <dependencies>
        <!-- Reader/writer/AST over @ExerisDomain sources. Pulls exeris-sdk-source-model
             (the canonical DomainMetadata records) and JavaParser transitively. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-source-model-io</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
        </dependency>
        <!-- gson: LSP4J wire layer; used directly for the JsonElement boundary of
             exeris/applyMutation. jackson-databind: (de)serializes the SDK's polymorphic
             MutationOp / MutationResult per the SDK consumer contract (Gson can't — it
             ignores the @JsonTypeInfo op/outcome discriminators). -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- WebSocket transport ADR-084: SPI for compile, Community provider for standalone runtime & tests -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <scope>runtime</scope>
            <!-- The launcher takes one provider from the Community bundle: WebSocketProvider. The
                 graph provider's Neo4j driver (with netty and reactor-core under it) serves no
                 code path here, so it stays out of the runtime classpath and the shaded jar;
                 ServiceLoader instantiates only the providers of the interface it is asked for. -->
            <exclusions>
                <exclusion>
                    <groupId>org.neo4j.driver</groupId>
                    <artifactId>neo4j-java-driver</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- `mvn -pl exeris-platform-lsp exec:java` launches the stdio server;
                 this is the default EXERIS_LSP_COMMAND target consumed by exeris-ai-bridge. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>eu.exeris.platform.lsp.LspMain</mainClass>
                </configuration>
            </plugin>

            <!--
                Runs LauncherIT against the jar the shade plugin below produces. Bound to
                failsafe rather than surefire because it needs `package` to have finished:
                everything surefire can see is the reactor classpath, and the artifact a
                consumer actually runs is assembled after that.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!-- Named, not globbed: a leftover jar from an earlier version in a
                             dirty target/ must not be able to pass for this one. -->
                        <exeris.lsp.jar>${project.build.directory}/${project.build.finalName}-standalone.jar</exeris.lsp.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                The standalone launcher: one self-contained jar a consumer can run as
                `java -jar` with no source tree and no Maven reactor. exeris-ai-bridge
                launches this server today as `mvn -pl exeris-platform-lsp exec:java`,
                which needs both; a machine that only consumes Exeris has neither.

                ATTACHED under a classifier rather than replacing the main artifact —
                a deliberate divergence from exeris-kernel-diagnostics-cli, which is a
                pure executable and can afford to replace its own jar. This module is
                also a library on paper (the BOM manages it, and an in-JVM IDE plugin
                would consume it as one), and handing such a consumer a jar with
                JavaParser, LSP4J, Jackson and the whole source model baked in is a
                classpath hazard rather than a convenience. The thin jar stays the main
                artifact; `-standalone` is the thing you run.

                Fetch the launcher with `-Dtransitive=false`. Everything it runs on —
                the SDK, the kernel's WebSocket provider, LSP4J, Jackson — is inside the
                jar, so resolving the main POM's dependency tree beside it only downloads
                a second copy of the same classes.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>standalone</shadedClassifierName>
                            <!-- The main artifact and its POM are untouched, so there is
                                 nothing to reduce; writing one would only publish a POM
                                 that disagrees with the jar beside it. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>eu.exeris.platform.lsp.LspMain</mainClass>
                                    <manifestEntries>
                                        <!-- gson and jackson-core are multi-release jars and
                                             their versioned classes survive the merge; without
                                             this the JVM ignores META-INF/versions/ entirely and
                                             silently runs the Java 8 fallbacks. -->
                                        <Multi-Release>true</Multi-Release>
                                        <!-- exeris-kernel-community calls restricted FFM methods
                                             (java.lang.foreign.Linker), which warn (and, on a JDK
                                             that enforces it, refuse) unless native access is
                                             granted. For an executable jar the manifest is the
                                             grant, so `java -jar` needs no command-line flag. It
                                             covers code on the class path only, which is where this
                                             jar runs. The sun.misc.Unsafe notice jctools emits is a
                                             separate deprecation and is not suppressed here. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <!-- Load-bearing: exeris-kernel-community registers its providers
                                     (WebSocketProvider among them) through META-INF/services, and
                                     the WebSocket transport finds its provider by ServiceLoader.
                                     Jackson ships service files too.
                                     Without this transformer the first jar's file for an interface
                                     wins and every later provider for it silently disappears; with
                                     it, files naming the same interface merge. The SDK jars carry
                                     none — the LSP reaches the source model by direct call. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signatures over the original jars; they cannot
                                             describe the merged one and make it unloadable. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Many dependencies ship a module-info; flattened into
                                             one jar they collide, and this artifact is run on the
                                             classpath, where they carry no meaning anyway. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
