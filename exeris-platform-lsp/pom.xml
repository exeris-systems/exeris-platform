<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.platform</groupId>
        <artifactId>exeris-platform-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../exeris-platform-parent</relativePath>
    </parent>

    <artifactId>exeris-platform-lsp</artifactId>
    <packaging>jar</packaging>

    <name>Exeris Platform :: LSP Server</name>
    <description>
        Language Server Protocol implementation hosting the canonical
        DomainMetadata model. Single LSP server consumed by Studio (web/desktop),
        IntelliJ plugin, and VS Code extension — guaranteeing one model, one
        edit pipeline, idempotent .java write-back, and bidirectional sync
        between Studio edits and IDE edits.
    </description>

    <dependencies>
        <!-- Reader/writer/AST over @ExerisDomain sources. Pulls exeris-sdk-source-model
             (the canonical DomainMetadata records) and JavaParser transitively. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-source-model-io</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
        </dependency>
        <!-- gson: LSP4J wire layer; used directly for the JsonElement boundary of
             exeris/applyMutation. jackson-databind: (de)serializes the SDK's polymorphic
             MutationOp / MutationResult per the SDK consumer contract (Gson can't — it
             ignores the @JsonTypeInfo op/outcome discriminators). -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- `mvn -pl exeris-platform-lsp exec:java` launches the stdio server;
                 this is the default EXERIS_LSP_COMMAND target consumed by exeris-ai-bridge. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>eu.exeris.platform.lsp.LspMain</mainClass>
                </configuration>
            </plugin>

            <!--
                Runs LauncherIT against the jar the shade plugin below produces. Bound to
                failsafe rather than surefire because it needs `package` to have finished:
                everything surefire can see is the reactor classpath, and the artifact a
                consumer actually runs is assembled after that.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!-- Named, not globbed: a leftover jar from an earlier version in a
                             dirty target/ must not be able to pass for this one. -->
                        <exeris.lsp.jar>${project.build.directory}/${project.build.finalName}-standalone.jar</exeris.lsp.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                The standalone launcher: one self-contained jar a consumer can run as
                `java -jar` with no source tree and no Maven reactor. exeris-ai-bridge
                launches this server today as `mvn -pl exeris-platform-lsp exec:java`,
                which needs both; a machine that only consumes Exeris has neither.

                ATTACHED under a classifier rather than replacing the main artifact —
                a deliberate divergence from exeris-kernel-diagnostics-cli, which is a
                pure executable and can afford to replace its own jar. This module is
                also a library on paper (the BOM manages it, and an in-JVM IDE plugin
                would consume it as one), and handing such a consumer a jar with
                JavaParser, LSP4J, Jackson and the whole source model baked in is a
                classpath hazard rather than a convenience. The thin jar stays the main
                artifact; `-standalone` is the thing you run.

                CAVEAT for whoever resolves this: eu.exeris:exeris-sdk-* is published to
                no Maven repository at all — every consumer builds it from source (see
                the sibling-checkout steps in .github/workflows/build.yml) — so the main
                POM's dependencies are NOT resolvable off-repo. Fetch the launcher with
                `-Dtransitive=false`. That is exactly what shading makes safe: the SDK
                classes are inside this jar, so nothing needs to resolve them at runtime.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>standalone</shadedClassifierName>
                            <!-- The main artifact and its POM are untouched, so there is
                                 nothing to reduce; writing one would only publish a POM
                                 that disagrees with the jar beside it. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>eu.exeris.platform.lsp.LspMain</mainClass>
                                    <manifestEntries>
                                        <!-- gson and jackson-core are multi-release jars and
                                             their versioned classes survive the merge; without
                                             this the JVM ignores META-INF/versions/ entirely and
                                             silently runs the Java 8 fallbacks. -->
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <!-- Measured, not copied: the SDK jars carry no META-INF/services
                                     at all (the LSP reaches the source model by direct call, not
                                     ServiceLoader). What does carry service files is Jackson 3 —
                                     tools.jackson.databind.ObjectMapper and
                                     tools.jackson.core.TokenStreamFactory. They name different
                                     interfaces today, so nothing collides yet; the transformer is
                                     here so that a second provider for either one merges instead
                                     of one file overwriting the other. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signatures over the original jars; they cannot
                                             describe the merged one and make it unloadable. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Five dependencies ship a module-info; flattened into
                                             one jar they collide, and this artifact is run on the
                                             classpath, where they carry no meaning anyway. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
