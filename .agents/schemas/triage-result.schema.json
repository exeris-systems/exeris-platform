{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage result (exeris-platform)",
  "description": "What exeris-platform-router hands to whoever runs next. Composed over the bundle base with task classes, roles, and validation gates narrowed to exeris-platform and closed.",
  "allOf": [
    {
      "$ref": "../vendor/exeris-agents-2.1.0/schemas/triage-result.base.schema.json"
    },
    {
      "properties": {
        "task_class": {
          "enum": [
            "ARCHITECTURE",
            "BACKEND_IMPLEMENTATION",
            "LSP_PROTOCOL",
            "FRONTEND_IMPLEMENTATION",
            "DOCS_ADR",
            "CROSS_BUILD",
            "MULTI_DOMAIN"
          ]
        },
        "primary_agent": {
          "enum": [
            "exeris-platform-router",
            "exeris-platform-architect",
            "exeris-platform-implementer",
            "exeris-platform-lsp-protocol",
            "exeris-platform-docs-adr",
            "exeris-platform-evaluator"
          ]
        },
        "secondary_handoffs": {
          "items": {
            "$ref": "handoff.schema.json"
          }
        },
        "validation_gates": {
          "items": {
            "allOf": [
              {
                "$ref": "../vendor/exeris-agents-2.1.0/schemas/triage-result.base.schema.json#/properties/validation_gates/items"
              }
            ],
            "unevaluatedProperties": false
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
