{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff (exeris-platform)",
  "description": "One agent passing work to another within exeris-platform. Composed over the bundle base with role vocabulary narrowed to this repository's roles and closed.",
  "allOf": [
    {
      "$ref": "../vendor/exeris-agents-2.1.0/schemas/handoff.base.schema.json"
    },
    {
      "properties": {
        "from": {
          "enum": [
            "human",
            "exeris-platform-router",
            "exeris-platform-architect",
            "exeris-platform-implementer",
            "exeris-platform-lsp-protocol",
            "exeris-platform-docs-adr",
            "exeris-platform-evaluator"
          ]
        },
        "to": {
          "enum": [
            "human",
            "exeris-platform-router",
            "exeris-platform-architect",
            "exeris-platform-implementer",
            "exeris-platform-lsp-protocol",
            "exeris-platform-docs-adr",
            "exeris-platform-evaluator"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
