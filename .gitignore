# Machine-local MCP server config. The rest of .claude/ (skills, agents, commands) is
# deliberately checked in and shared; this one file is not, because it records an
# absolute working directory that is true only on the machine that wrote it.
.claude/mcp.json

# Claude
.claude/worktrees/

# Agents — hook session state, keyed per session
.agents-state/

# The eval runner's report. A run is evidence for one pull request, not repository content, and it
# carries a timestamp that would make every run a diff.
working-notes/eval-report.json
