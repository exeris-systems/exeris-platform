    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@exeris/ui-kit": "^0.2.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@exeris/codegen-ts": "0.9.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jsdom": "^30.0.0",
