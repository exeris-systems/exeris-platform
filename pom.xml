<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris.platform</groupId>
    <artifactId>exeris-platform-root</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris Platform :: Root</name>
    <description>
        Exeris Platform — Studio (Angular shell + embedded React editor),
        backend services, and the LSP server that powers bidirectional sync
        between Studio, IDE plugins, and on-disk @ExerisDomain sources.
        Open-core; premium features ship in exeris-platform-enterprise.
    </description>
    <url child.project.url.inherit.append.path="false">https://github.com/exeris-systems/exeris-platform</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>arkstack-dev</id>
            <name>Arkadiusz Przychocki</name>
            <email>oss@exeris.eu</email>
            <organization>Exeris Systems</organization>
            <organizationUrl>https://exeris.eu</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/exeris-systems/exeris-platform.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exeris-systems/exeris-platform.git</developerConnection>
        <url>https://github.com/exeris-systems/exeris-platform</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/exeris-systems/exeris-platform/issues</url>
    </issueManagement>

    <!--
        GitHub Packages, not Maven Central — and the swap is deliberate.

        Central is still where these coordinates belong at 1.0.0 (ROADMAP), and 0.2.0 put the
        Central URLs here to have the metadata Central demands (url, organization, licenses,
        developers, scm, issueManagement) settled early. That metadata stays. What could not stay
        is Central as the DEFAULT deploy target: nothing in this repo is signed, no module attaches
        a sources or javadoc jar, and no eu.exeris coordinate is on Central yet — the ecosystem does
        not move there before exeris-kernel does. So `mvn deploy` aimed at a repository that would
        reject it, on a project whose real need is the opposite: a snapshot a consumer can fetch
        today.

        exeris-kernel already solved this exact split and is the reference: GitHub Packages as the
        default deploy target, Maven Central behind `-P release` with GPG signing, sources/javadoc
        jars and a readiness gate. Copy that profile from exeris-kernel/pom.xml when the time comes;
        deliberately NOT stubbed here, because a half-built `release` profile is a profile that
        uploads unsigned artifacts to an immutable repository.

        WHEN it comes is decided, and it is not soon. Central is gated on the rest of the stack
        arriving there first — exeris-kernel 0.12.0 (still in development), exeris-sdk 0.12.0 and
        exeris-tooling 0.9.0 — and on this repo reaching 0.6.0 at the earliest. Publishing a
        platform artifact to an immutable repository while its own dependencies resolve from
        nowhere would strand every consumer that tried to use it.

        And when it is wired, Central publishing is TAG-TRIGGERED, not dispatch-triggered: a
        Central version is spent the moment it is published, so the tag is what nominates the
        commit and there is no free-text version input to mistype. GitHub Packages keeps the
        current shape (snapshots on main, dispatch for releases) — the two channels differ because
        one is reversible and the other is not.
    -->
    <distributionManagement>
        <repository>
            <id>github-exeris-platform</id>
            <name>Exeris Platform — GitHub Packages</name>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-platform</url>
        </repository>
        <snapshotRepository>
            <id>github-exeris-platform</id>
            <name>Exeris Platform — GitHub Packages (Snapshots)</name>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-platform</url>
        </snapshotRepository>
    </distributionManagement>

    <modules>
        <module>exeris-platform-bom</module>
        <module>exeris-platform-parent</module>

        <module>exeris-studio-backend</module>
        <module>exeris-platform-lsp</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 25, matching exeris-kernel (release 25), exeris-sdk v0.10.0 (release 25) and
             exeris-tooling v0.7.0 (release 25, enforcer [25,)). This repo sat on 26 while its CI
             tracked exeris-tooling's `main`, whose enforcer was then [26,27); PR #20 pinned that
             checkout to the v0.7.0 tag and the constraint left with it.

             Load-bearing for a consumer, not a preference: exeris-platform-lsp ships a standalone
             launcher, and exeris-ai-bridge runs it beside exeris-kernel-diagnostics-cli. Emitting
             class-file 70 here would have meant one JDK floor for the kernel's artifact and a
             higher one for ours — a split no downstream can paper over. -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
