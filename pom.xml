<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris.platform</groupId>
    <artifactId>exeris-platform-root</artifactId>
    <version>0.5.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris Platform :: Root</name>
    <description>
        Exeris Platform — the open-source LSP server and its exeris/* protocol,
        which keep design-time clients (IDE plugins, exeris-ai-bridge, and
        Studio, Exeris' closed product) in sync with on-disk @ExerisDomain
        sources.
    </description>
    <url child.project.url.inherit.append.path="false">https://github.com/exeris-systems/exeris-platform</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>arkstack-dev</id>
            <name>Arkadiusz Przychocki</name>
            <email>oss@exeris.eu</email>
            <organization>Exeris Systems</organization>
            <organizationUrl>https://exeris.eu</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/exeris-systems/exeris-platform.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exeris-systems/exeris-platform.git</developerConnection>
        <url>https://github.com/exeris-systems/exeris-platform</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/exeris-systems/exeris-platform/issues</url>
    </issueManagement>

    <!--
        GitHub Packages, not Maven Central, is this repo's deploy target — and that is deliberate.

        The rest of the Exeris stack (exeris-kernel, exeris-sdk) is on Central, and
        this build resolves it from there. Central is also where these coordinates belong, which is
        why the metadata Central demands (url, organization, licenses, developers, scm,
        issueManagement) is already settled above. What is not settled is this repo's own release
        gate: nothing here is signed, no module attaches a sources or javadoc jar, and the platform
        does not go to an immutable repository before it reaches 0.6.0 at the earliest (ROADMAP).
        Until then `mvn deploy` targets GitHub Packages, because the actual need is a snapshot a
        consumer can fetch today.

        exeris-kernel solved this exact split and is the reference: GitHub Packages as the default
        deploy target, Maven Central behind `-P release` with GPG signing, sources/javadoc jars and
        a readiness gate. Copy that profile from exeris-kernel/pom.xml when the gate opens;
        deliberately NOT stubbed here, because a half-built `release` profile is a profile that
        uploads unsigned artifacts to an immutable repository.

        When it is wired it rides the same trigger everything else does: a release is a TAG. Both
        registries are fed by one cut, so a version can never exist on one and not the other. See
        .github/workflows/publish.yml.
    -->
    <distributionManagement>
        <repository>
            <id>github-exeris-platform</id>
            <name>Exeris Platform — GitHub Packages</name>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-platform</url>
        </repository>
        <snapshotRepository>
            <id>github-exeris-platform</id>
            <name>Exeris Platform — GitHub Packages (Snapshots)</name>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-platform</url>
        </snapshotRepository>
    </distributionManagement>

    <modules>
        <module>exeris-platform-bom</module>
        <module>exeris-platform-parent</module>

        <module>exeris-platform-lsp</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 25, matching the release level exeris-kernel and exeris-sdk compile to at the versions
             exeris-platform-bom pins (both: maven.compiler.release 25).
             Verify against those published POMs, not against this comment, when any of them moves.

             Load-bearing for a consumer, not a preference: exeris-platform-lsp ships a standalone
             launcher, and exeris-ai-bridge runs it beside exeris-kernel-diagnostics-cli. A newer
             class-file version here would mean one JDK floor for the kernel's artifact and a
             higher one for ours — a split no downstream can paper over. -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
