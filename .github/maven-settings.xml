<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <!--
      GitHub Packages authentication for `mvn deploy`.

      GITHUB_TOKEN is injected by the workflow and never hardcoded here; the username must be
      the org that owns the registry, not the acting user. The id matches
      <distributionManagement> in the root POM.

      This file is for PUBLISHING only. Reading is a separate concern this repo does not have:
      it depends on no published eu.exeris artifact — CI clones exeris-sdk and exeris-tooling
      and installs them from source (see build.yml) — so no <repositories> block belongs here.
    -->
    <server>
      <id>github-exeris-platform</id>
      <username>exeris-systems</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>
</settings>
